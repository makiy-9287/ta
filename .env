# ─────────────────────────────────────────────────────────────
#  REQUIRED - the only two values you must fill in
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=8893521930:AAHh4kFLjh_PWLWzkCcu8OepukqKOJVWipw
TELEGRAM_CHAT_ID=5530953384

# ─────────────────────────────────────────────────────────────
#  Everything below is optional - defaults are production-ready
# ─────────────────────────────────────────────────────────────

# Exchanges — the watchlist is split evenly between these venues, halving
# websocket load per IP. Candle history comes from HISTORY_EXCHANGE because
# it must publish taker-buy volume (Bybit klines do not).
EXCHANGES=binance,bybit
HISTORY_EXCHANGE=binance
BYBIT_BUDGET_PER_MIN=500
# If one venue's websockets connect but never deliver trades (a regional block
# or middlebox), streaming moves to the venue that works. The blocked venue is
# still used for candle history over REST, which is usually unaffected.
VENUE_STARVE_THRESHOLD=3
VENUE_BLOCK_MINUTES=60

# Event bus — websockets only enqueue; workers do all the maths.
QUEUE_SHARDS=2
QUEUE_MAXSIZE=20000
QUEUE_BATCH=256

# Universe
MIN_QUOTE_VOLUME_USD=20000000
WATCHLIST_REFRESH_HOURS=5
MAX_WATCHLIST=220
SYMBOL_BLACKLIST=
# Only trade symbols the history venue lists - candle history (and every
# historical delta/CVD figure) comes from there. Turning this off admits
# venue-exclusive symbols with degraded scoring.
REQUIRE_HISTORY_LISTING=true
# Tokenised metals, equities and pre-IPO products pass every volume filter but
# track an underlying this engine cannot see. Extend as venues list more.
# Tokenised EQUITIES and indices only. Tokenised metals (XAUT, PAXG, XAG) are
# deliberately allowed - they trade continuously against crypto liquidity and
# the volume filter already removes any that are too thin to read.
EXCLUDE_UNDERLYINGS=SPX,NDX,DJI,SPCX,OPENAI,MRVL,NVDA,TSLA,AAPL,MSFT,META,AMZN,GOOGL,NFLX,AMD,COIN,HOOD,MSTR,PLTR,GME,IBIT,CRCL

# Candles / zones
HTF_INTERVAL=4h
MTF_INTERVAL=1h
# Binance prices klines in tiers: <=500 candles costs weight 2, but 501-1000
# costs weight 5. So 600 candles costs 2.5x what 500 does for 20% more history,
# while 1000 costs exactly the same as 600. Pick 500 for the lightest startup,
# or 1000 to get the most history for the weight you are already paying.
CANDLE_LIMIT=600
ZONE_REFRESH_HOURS=4
SCORE_A_PLUS=80
SCORE_A=70
MAX_ZONE_TESTS=3
MAX_ZONES_PER_SYMBOL=5
STRUCTURAL_MAJOR_STRENGTH=0.70
ARM_BUFFER_ZONE_FRAC=0.25
STRUCTURAL_MIN_STRENGTH=0.55

# Trend handling — "strict" allows counter-trend setups only with an A+ zone,
# a fresh structural sweep and institutional participation.
RESPECT_HTF_TREND=true
COUNTER_TREND_POLICY=strict
COUNTER_TREND_PENALTY=0.08
LTF_OPPOSED_PENALTY=0.05

# Scanning
PROXIMITY_INTERVAL_SEC=300
MAX_ARMED_SYMBOLS=18
ARM_TTL_MINUTES=90
EVAL_INTERVAL_SEC=15
LTF_MID=15m

# Liquidity & heatmap
HEATMAP_BUCKETS=400
HEATMAP_HALF_LIFE_SEC=900
HEATMAP_RANGE_PCT=0.035
HEATMAP_TARGET_STRENGTH=0.30
LIQUIDITY_SPAN_PCT=0.08
LIQUIDITY_BIAS_MIN=0.50

# Sweep recency — a sweep older than this is stale liquidity; price will cut
# straight back through it. The stop goes beyond THIS sweep's wick.
SWEEP_MAX_AGE_BARS=5
SWEEP_FRESH_BARS=3
SWEEP_WICK_BARS=3
REQUIRE_STRUCTURAL_SWEEP=true

# Execution algorithms (TWAP / VWAP / iceberg)
ALGO_WINDOW_SEC=900
ALGO_MIN_CLIPS=12
ALGO_REGULARITY_MAX=0.35
ICEBERG_RATIO=2.5
REQUIRE_INSTITUTIONAL=false
VWAP_LOOKBACK=240
DERIVED_REFRESH_SEC=10

# Order flow thresholds
# Retention is long so CVD has history to work with. The ANALYSIS window is
# short and anchored to the sweep, because absorption is a statement about
# what happened AT the level, not across the last hour and a half.
FOOTPRINT_WINDOW_MIN=90
FLOW_ANALYSIS_MIN=25
FLOW_MIN_WINDOW_MIN=6
IMBALANCE_RATIO=3.0
DELTA_EXTREME_Z=1.30
ABSORPTION_VOL_MULT=1.90
ABSORPTION_EFFICIENCY=0.45
CVD_RECOVERY_FRAC=0.35
MIN_TRADES_FOR_FLOW=400

# Decision
MIN_CONFIDENCE=0.65
MIN_OPTIONAL_CONFIRMS=3

# Risk / targets — TPs are placed at liquidity pools, these are the minimum
# reward each one must still clear.
# Targets are placed at liquidity inside a reward WINDOW. TP1 must be close
# enough to actually be reached - it is what buys the breakeven stop - and TP3
# is capped by what 4H volatility can realistically deliver.
TP1_MIN_R=0.80
TP1_MAX_R=1.60
TP2_MIN_R=1.60
TP2_MAX_R=3.20
TP3_MIN_R=2.50
TP3_MAX_R=6.00
TP_REACH_ATR_MULT=1.6
TP_MIN_SEPARATION_R=0.40
SL_BUFFER_ATR=0.35
MAX_ACTIVE_TRADES=8
TRADE_TTL_HOURS=48

# Resilience
WS_IDLE_TIMEOUT_SEC=45
MARKPRICE_GIVE_UP_AFTER=8
WS_FLOW_IDLE_TIMEOUT_SEC=120
MAX_FLOW_AGE_SEC=240
REST_FALLBACK=true
FLOW_POLL_SEC=20
MAX_ARMED_FALLBACK=4
COMMAND_TIMEOUT_SEC=45
# An open setup whose price is older than this is not evaluated - a stale
# quote means a stop that HAS been hit would never be seen.
PRICE_MAX_AGE_SEC=90

# Schedule — weekend books are thin and their sweeps rarely follow through.
# The engine stops hunting Sat/Sun and wakes Monday morning; open setups are
# still monitored to completion while it sleeps.
# Days are Mon=0 .. Sun=6. Set TZ_OFFSET_HOURS to your local offset from UTC
# (e.g. 5.5 for IST) so "6 AM Monday" means your 6 AM.
WEEKEND_SLEEP=true
SLEEP_DAYS=5,6
WAKE_HOUR=6
TZ_OFFSET_HOURS=0

# System
WEIGHT_BUDGET_PER_MIN=1100
BULK_WEIGHT_SHARE=0.65
DB_PATH=data/sniper.db
LOG_LEVEL=INFO
LOG_FILE=data/sniper.log
