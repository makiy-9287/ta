# ─────────────────────────────────────────────────────────────
#  REQUIRED - the only two values you must fill in
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=8893521930:AAHh4kFLjh_PWLWzkCcu8OepukqKOJVWipw
TELEGRAM_CHAT_ID=5530953384

# ─────────────────────────────────────────────────────────────
#  Everything below is optional - defaults are production-ready
# ─────────────────────────────────────────────────────────────

# Exchanges — the watchlist is split evenly between these venues, halving
# websocket load per IP. Candle history comes from HISTORY_EXCHANGE because
# it must publish taker-buy volume (Bybit klines do not).
EXCHANGES=binance,bybit
HISTORY_EXCHANGE=binance
BYBIT_BUDGET_PER_MIN=500

# Event bus — websockets only enqueue; workers do all the maths.
QUEUE_SHARDS=2
QUEUE_MAXSIZE=20000
QUEUE_BATCH=256

# Universe
MIN_QUOTE_VOLUME_USD=20000000
WATCHLIST_REFRESH_HOURS=5
MAX_WATCHLIST=220
SYMBOL_BLACKLIST=

# Candles / zones
HTF_INTERVAL=4h
MTF_INTERVAL=1h
CANDLE_LIMIT=600
ZONE_REFRESH_HOURS=4
SCORE_A_PLUS=80
SCORE_A=70
MAX_ZONE_TESTS=3
STRUCTURAL_MIN_STRENGTH=0.55

# Trend handling — "strict" allows counter-trend setups only with an A+ zone,
# a fresh structural sweep and institutional participation.
RESPECT_HTF_TREND=true
COUNTER_TREND_POLICY=strict
COUNTER_TREND_PENALTY=0.08

# Scanning
PROXIMITY_INTERVAL_SEC=300
MAX_ARMED_SYMBOLS=18
ARM_TTL_MINUTES=90
EVAL_INTERVAL_SEC=15
LTF_MID=15m

# Liquidity & heatmap
HEATMAP_BUCKETS=400
HEATMAP_HALF_LIFE_SEC=900
HEATMAP_RANGE_PCT=0.035
HEATMAP_TARGET_STRENGTH=0.30
LIQUIDITY_SPAN_PCT=0.08
LIQUIDITY_BIAS_MIN=0.50

# Sweep recency — a sweep older than this is stale liquidity; price will cut
# straight back through it. The stop goes beyond THIS sweep's wick.
SWEEP_MAX_AGE_BARS=5
SWEEP_FRESH_BARS=3
SWEEP_WICK_BARS=3
REQUIRE_STRUCTURAL_SWEEP=true

# Execution algorithms (TWAP / VWAP / iceberg)
ALGO_WINDOW_SEC=900
ALGO_MIN_CLIPS=12
ALGO_REGULARITY_MAX=0.35
ICEBERG_RATIO=2.5
REQUIRE_INSTITUTIONAL=false
VWAP_LOOKBACK=240
DERIVED_REFRESH_SEC=10

# Order flow thresholds
FOOTPRINT_WINDOW_MIN=90
IMBALANCE_RATIO=3.0
DELTA_EXTREME_Z=1.30
ABSORPTION_VOL_MULT=1.90
ABSORPTION_EFFICIENCY=0.45
CVD_RECOVERY_FRAC=0.35
MIN_TRADES_FOR_FLOW=400

# Decision
MIN_CONFIDENCE=0.65
MIN_OPTIONAL_CONFIRMS=3

# Risk / targets — TPs are placed at liquidity pools, these are the minimum
# reward each one must still clear.
TP1_MIN_R=0.85
TP2_MIN_R=2.50
TP3_MIN_R=3.50
SL_BUFFER_ATR=0.35
MAX_ACTIVE_TRADES=8
TRADE_TTL_HOURS=48

# Resilience
WS_IDLE_TIMEOUT_SEC=45
WS_FLOW_IDLE_TIMEOUT_SEC=120
MAX_FLOW_AGE_SEC=240
REST_FALLBACK=true
FLOW_POLL_SEC=20
MAX_ARMED_FALLBACK=4
COMMAND_TIMEOUT_SEC=45

# System
WEIGHT_BUDGET_PER_MIN=1100
BULK_WEIGHT_SHARE=0.65
DB_PATH=data/sniper.db
LOG_LEVEL=INFO
LOG_FILE=data/sniper.log
